---
import ShaderCanvas from './HeroShader.astro';
---

<!-- 
  SEZIONE HERO FULL-BLEED:
  - Dynamic Viewport Height h-[100dvh] per evitare il taglio in basso su Chrome mobile.
-->
<section class="w-screen relative left-1/2 -translate-x-1/2 h-screen h-[100dvh] flex flex-col justify-between pt-20 pb-6 md:pt-32 md:pb-12 px-5 sm:px-8 md:px-10 lg:px-12 select-none [touch-action:pan-y] overflow-hidden">  
  
  <ShaderCanvas />

  <!-- Glow di sfondo con blend-mode -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-amber-900/10 via-zinc-800/10 to-transparent blur-[120px] pointer-events-none -z-10 mix-blend-screen"></div>

  <div class="w-full"></div>

  <!-- Centro: Copy & Icona Wireframe -->
  <div class="reveal-ui opacity-0 translate-y-8 flex flex-col items-center text-center max-w-2xl mx-auto my-auto z-10 pointer-events-none mix-blend-difference text-white transform-gpu will-change-[transform,opacity] antialiased">
    <div class="mb-8 animate-pulse text-white/50">
      <svg class="w-10 h-10 mx-auto stroke-current" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      </svg>
    </div>
  </div> 

  <!-- Bottom: Titolo e Ruolo -->
  <div class="w-full mt-auto pb-2 md:pb-0 z-10 pointer-events-none mix-blend-difference text-white shrink-0">
    <div class="w-full flex flex-col">
      <h1 class="sr-only">ENRICO SCIGLIUTO</h1>
      
      <!-- 
        CONTENITORE FULL-BLEED SENZA MARGINI:
        - mx-[-1.25rem] sm:mx-[-2rem] md:mx-[-2.5rem] lg:mx-[-3rem]: 
          I margini negativi ANNULLANO esattamente il padding della sezione (px-5, sm:px-8, etc.), 
          spingendo il titolo a toccare fisicamente i bordi dello schermo se lo desideri, oppure i bordi reali del layout.
      -->
      <div class="reveal-ui opacity-0 translate-y-12 hero-title block w-full overflow-visible transform-gpu will-change-[transform,opacity]">
        <svg 
          viewBox="0 0 940 90" 
          class="w-full h-auto block overflow-visible" 
          aria-hidden="true"
          preserveAspectRatio="none"
        >
          <text 
            x="0" 
            y="50%" 
            dominant-baseline="central" 
            textLength="940" 
            lengthAdjust="spacingAndGlyphs" 
            class="font-display fill-white uppercase font-black" 
            font-size="95"
          >
            ENRICO SCIGLIUTO
          </text>
        </svg>
      </div>

      <p class="reveal-ui opacity-0 translate-y-8 text-right font-sans font-light text-lg sm:text-2xl md:text-4xl opacity-70 tracking-tight mt-1 md:mt-2 [font-optical-sizing:auto] mr-1 sm:mr-4 md:mr-2 text-white transform-gpu will-change-[transform,opacity]">
        Creative Technologist
      </p>
    </div>
  </div>
</section>