---
import ShaderCanvas from './HeroShader.astro';
---

<!-- 
  SEZIONE HERO FULL-BLEED:
  - touch-action:pan-y per lo scroll mobile fluido.
  - Nessun colore di sfondo solido per non isolare lo Stacking Context di mix-blend-difference.
-->
<section class="w-screen relative left-1/2 -translate-x-1/2 min-h-screen flex flex-col justify-between pt-32 pb-6 md:pb-12 px-5 sm:px-8 md:px-10 lg:px-12 select-none [touch-action:pan-y]">  
  
  <ShaderCanvas />

  <!-- Glow di sfondo con blend-mode per integrarsi col canvas -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-amber-900/10 via-zinc-800/10 to-transparent blur-[120px] pointer-events-none -z-10 mix-blend-screen"></div>

  <div class="w-full"></div>

  <!-- Centro: Copy & Icona Wireframe (con hardware acceleration e blend pulito) -->
  <div class="reveal-ui opacity-0 translate-y-8 flex flex-col items-center text-center max-w-2xl mx-auto my-auto z-10 pointer-events-none mix-blend-difference text-white transform-gpu will-change-[transform,opacity] antialiased">
    <div class="mb-8 animate-pulse text-white/50">
      <svg class="w-10 h-10 mx-auto stroke-current" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- <circle cx="12" cy="12" r="10" stroke-width="1" />
        <ellipse cx="12" cy="12" rx="4" ry="10" stroke-width="1" />
        <path d="M2 12H22" stroke-width="1" />
        <path d="M4 7H20" stroke-width="1" />
        <path d="M4 17H20" stroke-width="1" /> -->
      </svg>
    </div>

  <!--
    <p class="text-xl sm:text-2xl md:text-3xl font-light tracking-tight leading-[1.35] mb-6 text-white">
      Progetto e sviluppo esperienze multimediali che provocano emozioni.
    </p>
    <p class="text-xs sm:text-sm font-mono uppercase tracking-widest opacity-60 max-w-md leading-relaxed text-white">
      Architetture Web Zero-JS // Streaming HLS Edge // Interazioni Generative GLSL
    </p> -->
  </div> 

  <!-- Bottom: Titolo SVG e Ruolo -->
  <!-- Rimosso overflow-hidden dal container per evitare che tagli i bordi durante la transizione -->
  <div class="w-full pt-1 mt-auto z-10 pointer-events-none mix-blend-difference text-white">
    <div class="w-full flex flex-col">
      <h1 class="sr-only">ENRICO SCIGLIUTO</h1>
      
      <!-- L'SVG ha transform-gpu e isolation per evitare glitch nel rendering vettoriale -->
      <svg 
        viewBox="0 0 1000 100" 
        class="reveal-ui opacity-0 translate-y-12 hero-title w-full h-auto block overflow-visible transform-gpu will-change-[transform,opacity]" 
        preserveAspectRatio="none" 
        aria-hidden="true"
      >
        <text 
          x="0" 
          y="55%" 
          dominant-baseline="central" 
          textLength="100%" 
          lengthAdjust="spacingAndGlyphs" 
          class="font-display fill-white uppercase font-black" 
          font-size="110"
        >
          ENRICO SCIGLIUTO
        </text>
      </svg>

      <p class="reveal-ui opacity-0 translate-y-8 text-right font-sans font-light text-xl sm:text-2xl md:text-4xl opacity-70 tracking-tight mt-0 [font-optical-sizing:auto] mr-2 sm:mr-4 md:mr-2 text-white transform-gpu will-change-[transform,opacity]">
        Creative Technologist
      </p>
    </div>
  </div>
</section>