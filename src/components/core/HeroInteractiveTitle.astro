---

<div class="relative w-full h-[20vh] sm:h-[25vh] md:h-[30vh] flex items-center justify-center pointer-events-auto">
  <canvas id="interactive-title-canvas" class="absolute inset-0 w-full h-full"></canvas>
</div>

<script>
  import * as THREE from 'three';

  const canvas = document.getElementById('interactive-title-canvas') as HTMLCanvasElement;
  if (canvas) {
    // Setup di base[cite: 8]
    const scene = new THREE.Scene();
    const vMouse = new THREE.Vector2(-1000, -1000); // Fuori schermo all'avvio
    const vMouseDamp = new THREE.Vector2(-1000, -1000); // Coordinate smorzate[cite: 8]
    const vResolution = new THREE.Vector2();

    let w = canvas.clientWidth;
    let h = canvas.clientHeight;

    // Setup Telecamera Ortografica[cite: 8]
    const aspect = w / h;
    const camera = new THREE.OrthographicCamera(-aspect, aspect, 1, -1, 0.1, 1000);
    camera.position.z = 1;[cite: 8]

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    
    // Gestione Eventi Mouse/Touch[cite: 8]
    const onPointerMove = (e: MouseEvent | TouchEvent) => {
      const rect = canvas.getBoundingClientRect();
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      
      // Calcoliamo la posizione relativa al canvas
      vMouse.set(clientX - rect.left, clientY - rect.top);
    };
    canvas.addEventListener('mousemove', onPointerMove);
    canvas.addEventListener('pointermove', onPointerMove);

    // Geometria a pieno schermo[cite: 8]
    const geo = new THREE.PlaneGeometry(1, 1);[cite: 8]

    // Caricamento Texture (il tuo PNG)
    const textureLoader = new THREE.TextureLoader();
    const textTexture = textureLoader.load('/enrico-scigliuto-title.png');

    // Shader Material[cite: 8]
    const mat = new THREE.ShaderMaterial({
      vertexShader: `
        varying vec2 v_texcoord;
        void main() {
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); //[cite: 8]
            v_texcoord = uv; //[cite: 8]
        }
      `,
      fragmentShader: `
        varying vec2 v_texcoord; //[cite: 7]
        uniform vec2 u_mouse; //[cite: 7]
        uniform vec2 u_resolution; //[cite: 7]
        uniform float u_pixelRatio; //[cite: 7]
        uniform sampler2D u_text_texture;

        // Funzione di centramento coordinate[cite: 7]
        vec2 coord(in vec2 p) {
            p = p / u_resolution.xy;
            if (u_resolution.x > u_resolution.y) {
                p.x *= u_resolution.x / u_resolution.y;
                p.x += (u_resolution.y - u_resolution.x) / u_resolution.y / 2.0;
            } else {
                p.y *= u_resolution.y / u_resolution.x;
                p.y += (u_resolution.x - u_resolution.y) / u_resolution.x / 2.0;
            }
            p -= 0.5;
            p *= vec2(-1.0, 1.0);
            return p;
        }

        #define st0 coord(gl_FragCoord.xy) //[cite: 7]
        #define mx coord(u_mouse * u_pixelRatio) //[cite: 7]

        // Signed Distance Function per il cerchio[cite: 7]
        float sdCircle(in vec2 st, in vec2 center) {
            return length(st - center) * 2.0; //[cite: 7]
        }

        // Funzione di fill con smoothstep[cite: 7]
        float fill(float x, float size, float edge) {
            return 1.0 - smoothstep(size - edge, size + edge, x); //[cite: 7]
        }

        void main() {
            vec2 st = st0 + 0.5; //[cite: 7]
            vec2 posMouse = mx * vec2(1., -1.) + 0.5; //[cite: 7]
            
            // Parametri interazione[cite: 7]
            float circleSize = 0.35; //[cite: 7]
            float circleEdge = 0.4; //[cite: 7]
            
            // Calcolo SDF del mouse[cite: 7]
            float sdfCircle = fill(sdCircle(st, posMouse), circleSize, circleEdge); //[cite: 7]
            
            // Lettura PNG
            vec4 texColor = texture2D(u_text_texture, v_texcoord);
            
            // EFFETTO: Il testo è grigio scuro (#444) di base, 
            // ma diventa bianco brillante quando il mouse (sdfCircle) ci passa sopra.
            vec3 baseColor = vec3(0.26, 0.26, 0.26);
            vec3 hoverColor = vec3(1.0, 1.0, 1.0);
            vec3 finalColor = mix(baseColor, hoverColor, sdfCircle);

            gl_FragColor = vec4(finalColor, texColor.a);
        }
      `,
      uniforms: {
        u_mouse: { value: vMouseDamp }, //[cite: 8]
        u_resolution: { value: vResolution }, //[cite: 8]
        u_pixelRatio: { value: 1 }, //[cite: 8]
        u_text_texture: { value: textTexture }
      },
      transparent: true
    });

    const quad = new THREE.Mesh(geo, mat); //[cite: 8]
    scene.add(quad); //[cite: 8]

    // Loop di animazione[cite: 8]
    let time, lastTime = 0; //[cite: 8]
    const update = () => {
      time = performance.now() * 0.001; //[cite: 8]
      const dt = time - lastTime; //[cite: 8]
      lastTime = time; //[cite: 8]

      // Smorzamento del movimento del mouse[cite: 8]
      for (const k in vMouse) {
        if (k == 'x' || k == 'y') vMouseDamp[k as keyof typeof vMouse] = THREE.MathUtils.damp(vMouseDamp[k as keyof typeof vMouseDamp], vMouse[k as keyof typeof vMouse], 8, dt); //[cite: 8]
      }

      requestAnimationFrame(update); //[cite: 8]
      renderer.render(scene, camera); //[cite: 8]
    };
    update(); //[cite: 8]

    // Gestione Resize[cite: 8]
    const resize = () => {
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      const dpr = Math.min(window.devicePixelRatio, 2); //[cite: 8]

      renderer.setSize(w, h, false); // false evita di sovrascrivere lo stile CSS
      renderer.setPixelRatio(dpr); //[cite: 8]

      camera.left = -w / 2; //[cite: 8]
      camera.right = w / 2; //[cite: 8]
      camera.top = h / 2; //[cite: 8]
      camera.bottom = -h / 2; //[cite: 8]
      camera.updateProjectionMatrix(); //[cite: 8]

      quad.scale.set(w, h, 1); //[cite: 8]
      vResolution.set(w, h).multiplyScalar(dpr); //[cite: 8]
      mat.uniforms.u_pixelRatio.value = dpr; //[cite: 8]
    };
    window.addEventListener('resize', resize); //[cite: 8]
    resize(); //[cite: 8]
  }
</script>
