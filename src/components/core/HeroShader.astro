---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div 
  id="shader-container" 
  class={`absolute inset-0 w-full h-full overflow-hidden -z-20 pointer-events-none ${className}`}
  style="-webkit-mask-image: linear-gradient(to bottom, black 65%, transparent 100%); mask-image: linear-gradient(to bottom, black 65%, transparent 100%);"
>
  <canvas id="hero-shader-canvas" class="w-full h-full block"></canvas>
</div>
<script>
  import * as THREE from 'three';

  function initShaderCanvas() {
    const canvas = document.getElementById('hero-shader-canvas');
    const container = document.getElementById('shader-container');
    
    if (!canvas || !container) return;
    if (canvas.hasAttribute('data-engine-active')) return;
    canvas.setAttribute('data-engine-active', 'true');

    // Manteniamo la logica Mobile DPR
    const isMobile = window.innerWidth < 768;
    const pixelRatio = isMobile ? 1.0 : Math.min(window.devicePixelRatio, 2);

    const renderer = new THREE.WebGLRenderer({ 
      canvas: canvas, 
      alpha: true, 
      antialias: false,
      powerPreference: "high-performance"
    });
    
    const width = container.offsetWidth;
    const height = container.offsetHeight;
    renderer.setSize(width, height);
    renderer.setPixelRatio(pixelRatio);
    renderer.autoClear = false;

    // Rimpicciolito il cursore/spessore del pennello su mobile (da 0.02 a 0.01)
    const dynamicThickness = isMobile ? 0.01 : 0.035;

    const simSize = 1024/2;
    const renderTargetParams = {
      wrapS: THREE.ClampToEdgeWrapping, wrapT: THREE.ClampToEdgeWrapping,
      minFilter: THREE.LinearFilter, magFilter: THREE.LinearFilter,
      format: THREE.RGBAFormat, type: THREE.HalfFloatType, 
      depthBuffer: false, stencilBuffer: false
    };

    let readBuffer = new THREE.WebGLRenderTarget(simSize, simSize, renderTargetParams);
    let writeBuffer = readBuffer.clone();

    const simScene = new THREE.Scene();
    const simCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    
    const simMaterial = new THREE.ShaderMaterial({
      uniforms: {
        tInput: { value: null },
        u_mouseOld: { value: new THREE.Vector2(0.5, 0.5) },
        u_mouseNew: { value: new THREE.Vector2(0.5, 0.5) },
        u_isDrawing: { value: 0.0 },
        u_thickness: { value: dynamicThickness }, 
        u_persistence: { value: 0.985 } 
      },
      vertexShader: `varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position, 1.0); }`,
      fragmentShader: `
        uniform sampler2D tInput; uniform vec2 u_mouseOld; uniform vec2 u_mouseNew;
        uniform float u_isDrawing; uniform float u_thickness; uniform float u_persistence;
        varying vec2 vUv;

        float lineSegment(vec2 p, vec2 a, vec2 b, float thickness) {
          vec2 pa = p - a; vec2 ba = b - a;
          float h = clamp(dot(pa,ba)/dot(ba,ba), 0.0, 1.0);
          float dist = length(pa - ba*h);
          return smoothstep(thickness, 0.0, dist);
        }

        void main() {
          vec4 oldCol = texture2D(tInput, vUv);
          oldCol *= u_persistence;
          if (u_isDrawing > 0.5) oldCol += vec4(lineSegment(vUv, u_mouseOld, u_mouseNew, u_thickness));
          gl_FragColor = clamp(oldCol, 0.0, 1.0);
        }
      `
    });
    
    simScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), simMaterial));

    const mainScene = new THREE.Scene();
    const mainCamera = new THREE.PerspectiveCamera(45, width / height, 0.1, 100);
    mainCamera.position.set(0, -0.6, 5.5);
    mainCamera.lookAt(0, 0, 0);

    const mainUniforms = {
      u_time: { value: 0.0 },
      u_resolution: { value: new THREE.Vector2(width, height) },
      u_trail: { value: readBuffer.texture } 
    };

    const displacementLogic = `
      vec2 hash2D(vec2 p) { p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3))); return fract(sin(p) * 43758.5453123); }
      float noise(vec2 p) {
        vec2 i = floor(p); vec2 f = fract(p); vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(dot(hash2D(i + vec2(0.0,0.0)), f - vec2(0.0,0.0)), dot(hash2D(i + vec2(1.0,0.0)), f - vec2(1.0,0.0)), u.x),
                   mix(dot(hash2D(i + vec2(0.0,1.0)), f - vec2(0.0,1.0)), dot(hash2D(i + vec2(1.0,1.0)), f - vec2(1.0,1.0)), u.x), u.y);
      }
      float fluidNoise(vec2 p, float time) {
        vec2 q = vec2(noise(p + vec2(0.0, time * 0.2)), noise(p + vec2(5.2, time * 0.13)));
        vec2 r = vec2(noise(p + 4.0 * q + vec2(1.7 - time * 0.15, 9.2 + time * 0.15)), noise(p + 4.0 * q + vec2(8.3 - time * 0.1, 2.8 + time * 0.2)));
        return noise(p + 2.5 * r);
      }
      
      float getElevation(vec2 uvCoord, float time, vec2 resolution, sampler2D trailTex) {
        float trailIntensity = texture2D(trailTex, uvCoord).r;
        
        float aspect = resolution.x / resolution.y;
        // Moltiplicatore dinamico: rimpicciolisce la scala UV su mobile (format verticale)
        float uvScale = aspect < 1.0 ? (1.0 / aspect) * 1.2 : 1.0;
        
        vec2 uvCover = (uvCoord - 0.5) * vec2(max(aspect, 1.0), max(1.0 / aspect, 1.0)) * uvScale + 0.5;

        float pulseTime = time * 1.2;
        float pulseEnvelope = atan(sin(pulseTime)) * .5 + 0.75;
        
        float fluidPattern = fluidNoise(uvCover * 3.0, time * 0.8);
        float wavePattern = sin(length(uvCover) * 8.0 - time * 2.5 + fluidPattern * 4.0) * 0.5 + 0.5;
        float baseDisplacement = wavePattern * pulseEnvelope * (1.0 + fluidPattern * 0.5);

        return baseDisplacement + (trailIntensity * (1.0 + fluidPattern * 10.5) * 1.5);
      }
    `;

    const vertexShader = `
      uniform float u_time; uniform vec2 u_resolution; uniform sampler2D u_trail;
      varying float vDisplacement; varying vec2 vUv; 
      ${displacementLogic}
      void main() {
        vUv = uv; 
        vDisplacement = getElevation(vUv, u_time, u_resolution, u_trail);
        vec3 displacedPosition = position;
        displacedPosition.z += vDisplacement * .418;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(displacedPosition, 1.0);
      }
    `;

    const fragmentShader = `
      uniform float u_time;
      uniform vec2 u_resolution;
      uniform vec2 u_mouse;
      uniform sampler2D u_trail;

      varying vec2 vUv;
      varying float vDisplacement;

      vec2 hash2D(vec2 p) {
        p = vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)));
        return fract(sin(p) * 43758.5453123);
      }

      float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(dot(hash2D(i + vec2(0.0,0.0)), f - vec2(0.0,0.0)),
                       dot(hash2D(i + vec2(1.0,0.0)), f - vec2(1.0,0.0)), u.x),
                   mix(dot(hash2D(i + vec2(0.0,1.0)), f - vec2(0.0,1.0)),
                       dot(hash2D(i + vec2(1.0,1.0)), f - vec2(1.0,1.0)), u.x), u.y);
      }

      float fluidNoise(vec2 p, float time) {
        vec2 q = vec2(noise(p + vec2(0.0, time * 0.2)), noise(p + vec2(5.2, time * 0.13)));
        vec2 r = vec2(noise(p + 4.0 * q + vec2(1.7 - time * 0.15, 9.2 + time * 0.15)),
                      noise(p + 4.0 * q + vec2(8.3 - time * 0.1, 2.8 + time * 0.2)));
        return noise(p + 2.5 * r);
      }

      float getElevation(vec2 uv, float time, vec2 resolution, sampler2D trail) {
        float aspect = resolution.x / resolution.y;
        float uvScale = aspect < 1.0 ? (1.0 / aspect) * 1.4 : 1.0;
        vec2 uvScaled = (uv - 0.5) * vec2(max(aspect, 1.0), max(1.0 / aspect, 1.0)) * uvScale + 0.5;

        float pulseSpeed = 1.2;
        float pulseTime = time * pulseSpeed;
        float distFromRandom = length(uvScaled);
        float pulseEnvelope = sin(pulseTime) * 0.5 + 0.75;
        float fluidPattern = fluidNoise(uvScaled * 6.0, time * 0.8);
        float wavePattern = sin(distFromRandom * 8.0 - time * 2.5 + fluidPattern * 4.0) * 0.5 + 0.5;
        return wavePattern * pulseEnvelope * (1.0 + fluidPattern * 0.5);
      }

      vec3 ACESFilm(vec3 x) {
        float a = 2.51;
        float b = 0.03;
        float c = 2.43;
        float d = 0.59;
        float e = 0.14;
        return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
      }

      float randomDither(vec2 p) {
        return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453) - 0.5;
      }

      void main() {
        float blend = clamp(vDisplacement, 0.0, 1.0);
        vec3 colorBaseDark = vec3(0.04, 0.04, 0.05);
        vec3 colorSilver = vec3(0.55, 0.58, 0.62);
        vec3 colorChromeHighlight = vec3(0.92, 0.95, 0.98);

        vec3 aluminumBase = mix(colorBaseDark, colorSilver, smoothstep(0.05, 0.45, blend));
        aluminumBase = mix(aluminumBase, colorChromeHighlight, smoothstep(0.45, 0.85, blend));

        // ESTRAIAMO LA SCIA PURA PER CREARE LA RIFRAZIONE
        float rawTrail = texture2D(u_trail, vUv).r;

        // Colori prismatici animati basati sul tempo
        float waveOffset = blend * 6.28318 - (u_time * 3.0);
        vec3 rgbDispersion = vec3(
          sin(waveOffset) * 1.5 + 0.5, 
          sin(waveOffset + 2.094) * 0.75 + 0.5, 
          sin(waveOffset + 4.188) * 0.75 + 0.5
        );
        
        vec3 baseColor = aluminumBase + (rgbDispersion * smoothstep(0.15, .90, blend));

        // INIEZIONE RIFRAZIONE: Colori olografici brillanti miscelati esattamente dove passi il mouse
        vec3 refractionGlow = rgbDispersion * 1.5; 
        baseColor = mix(baseColor, refractionGlow, rawTrail * smoothstep(0.1, 1.0, rawTrail));

        float epsilon = 0.009; 
        float h0 = vDisplacement;
        float hX = getElevation(vUv + vec2(epsilon, 0.0), u_time, u_resolution, u_trail);
        float hY = getElevation(vUv + vec2(0.0, epsilon), u_time, u_resolution, u_trail);
        vec3 normal = normalize(vec3(-(hX - h0) * 20.0, -(hY - h0) * 20.0, 1.0));

        vec3 lightDir = normalize(vec3(1.0, 1.0, .5)); 
        float diffuse = max(dot(normal, lightDir), 0.0);
        float specular = pow(max(dot(normal, normalize(lightDir + vec3(0.0, 0.0, 1.0))), 0.0), 32.0); 

        vec3 shadedColor = baseColor * (diffuse + 0.35) + vec3(specular * (1.5 + rawTrail * 1.5)) + vec3(pow(smoothstep(0.6, 1.0, blend), 3.0) * 2.45);

        shadedColor = mix(shadedColor, ACESFilm(shadedColor), 1.25);

        vec2 uvCentered = vUv * 2.0 - 1.0;
        float vignette = 1.0 - dot(uvCentered, uvCentered) * 3.22;
        vignette = smoothstep(0.0, 1.0, vignette);
        shadedColor *= vignette;

        float dither = randomDither(gl_FragCoord.xy) * (1.0 / 255.0);
        shadedColor += dither * 52.0;

        gl_FragColor = vec4(smoothstep(0.02, 0.99, shadedColor / (vec3(1.0) + shadedColor)), 1.0);
      }
    `;

    const mainGeometry = new THREE.PlaneGeometry(16, 16, 400, 400);
    const mainMaterial = new THREE.ShaderMaterial({ vertexShader, fragmentShader, uniforms: mainUniforms, depthWrite: false, depthTest: false });
    const mesh = new THREE.Mesh(mainGeometry, mainMaterial);
    mesh.rotation.x = -.322; mesh.rotation.y = 0.04;  
    mainScene.add(mesh);

    // --- EVENTI NATIVI ---
    let isDrawing = false;
    const raycaster = new THREE.Raycaster();
    const mouseParams = new THREE.Vector2(-10, -10); 
    let pointerPos = new THREE.Vector2(0.5, 0.5);
    let prevPointerPos = new THREE.Vector2(0.5, 0.5);

    function updateMouseParams(e) {
      const rect = container?.getBoundingClientRect();
      if (!rect) return;
      const clientX = 'touches' in e ? e.touches[0].clientX : e.clientX;
      const clientY = 'touches' in e ? e.touches[0].clientY : e.clientY;
      mouseParams.x = ((clientX - rect.left) / rect.width) * 2 - 1;
      mouseParams.y = -((clientY - rect.top) / rect.height) * 2 + 1;
    }

    window.addEventListener('pointerdown', (e) => {
      isDrawing = true;
      updateMouseParams(e);
    }, { passive: true });
    
    window.addEventListener('pointerup', (e) => {
      if (e.pointerType !== 'mouse') isDrawing = false;
    }, { passive: true });
    
    window.addEventListener('pointercancel', (e) => {
      if (e.pointerType !== 'mouse') isDrawing = false;
    }, { passive: true });
    
    window.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'mouse') {
        isDrawing = true;
      }
      updateMouseParams(e);
    }, { passive: true });

    window.addEventListener('pointerleave', (e) => {
      isDrawing = false;
    }, { passive: true });

    function onResize() {
      if (!container || !renderer) return;
      const w = container.offsetWidth;
      const h = container.offsetHeight;
      const isMob = window.innerWidth < 768;
      const dpr = isMob ? 1.0 : Math.min(window.devicePixelRatio, 2);
      
      // Aggiorna anche dynamicThickness al resize
      simMaterial.uniforms.u_thickness.value = isMob ? 0.01 : 0.035;

      renderer.setPixelRatio(dpr);
      renderer.setSize(w, h);
      mainCamera.aspect = w / h;
      mainCamera.updateProjectionMatrix();
      mainUniforms.u_resolution.value.set(w, h);
    }
    window.addEventListener('resize', onResize, { passive: true });

    // --- RENDER LOOP ---
    let animationFrameId;

    function animate(time) {
      animationFrameId = requestAnimationFrame(animate);
      mainUniforms.u_time.value = time * 0.001;

      raycaster.setFromCamera(mouseParams, mainCamera);
      const intersects = raycaster.intersectObject(mesh);
      
      if (intersects.length > 0) {
        if (isDrawing) {
          pointerPos.copy(intersects[0].uv);
        } else {
          pointerPos.copy(intersects[0].uv);
          prevPointerPos.copy(intersects[0].uv);
        }
      }

      simMaterial.uniforms.tInput.value = readBuffer.texture;
      simMaterial.uniforms.u_mouseOld.value.copy(prevPointerPos);
      simMaterial.uniforms.u_mouseNew.value.copy(pointerPos);
      simMaterial.uniforms.u_isDrawing.value = isDrawing ? 1.0 : 0.0;

      renderer.setRenderTarget(writeBuffer);
      renderer.render(simScene, simCamera);

      const temp = readBuffer; readBuffer = writeBuffer; writeBuffer = temp;
      if (isDrawing) prevPointerPos.copy(pointerPos);

      renderer.setRenderTarget(null); 
      mainUniforms.u_trail.value = readBuffer.texture;
      renderer.render(mainScene, mainCamera);
    }
    requestAnimationFrame(animate);

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener('resize', onResize);
      mainGeometry.dispose(); mainMaterial.dispose(); simMaterial.dispose();
      renderer.dispose(); readBuffer.dispose(); writeBuffer.dispose();
    }, { once: true });
  }

  document.addEventListener('DOMContentLoaded', initShaderCanvas);
  document.addEventListener('astro:page-load', initShaderCanvas);
</script>