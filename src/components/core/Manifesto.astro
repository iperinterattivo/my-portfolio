---
// Componente Manifesto / About Me
---

<!-- 
  SPAZIATURA SEZIONE:
  - mt-6 mb-16 md:my-24: Ridotto il margine superiore su mobile a 24px (mt-6) invece di 96px.
  - pt-4 pb-12 md:py-24: Padding superiore iniziale minimo per mobile.
-->
<section id="about" class="about-container pt-4 pb-12 md:py-24 mt-6 mb-16 md:my-24 border-b border-zinc-900 overflow-hidden">
  
  <!-- Intestazione Monumentale -->
  <!-- pb-6 mb-8 md:pb-16 md:mb-20: Distanza tra titolo "ABOUT ME" e testo ridotta drasticamente su mobile -->
  <header class="pb-6 mb-8 md:pb-16 md:mb-20">
    <div class="font-mono text-xs uppercase tracking-widest text-zinc-500 mb-4 md:mb-8">
      <!-- [ 02 // ABOUT ENRICO SCIGLIUTO ]-->
    </div>
    
    <h2 class="font-display font-black text-6xl sm:text-8xl md:text-9xl lg:text-[10rem] tracking-tighter uppercase text-white leading-[0.85] md:leading-[0.08] flex flex-wrap items-center gap-x-4 sm:gap-x-10">
      <!-- "ABOUT" entra da SINISTRA -->
      <span class="about-slide-left inline-block">ABOUT</span> 
      <!-- "ME" entra da DESTRA -->
      <span class="me-slide-right inline-block">ME</span>
    </h2>
  </header>

  <!-- Griglia Editoriale Asimmetrica -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
    
    <!-- Colonna Sinistra: Filosofia / Bio (8 colonne su 12) -->
    <div class="lg:col-span-8 space-y-6 md:space-y-12">
      
      <!-- Paragrafo 1: Hero Statement -->
      <p class="split-reveal text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-medium text-white leading-[1.15] md:leading-[1.1] tracking-tight break-keep [hyphens:none] [overflow-wrap:normal]">
        Sono un creative technologist con&nbsp;un background in Visual &amp;&nbsp;Innovation Design. 
        Metto in&nbsp;simbiosi estetica e&nbsp;tecnologia, esplorandone le&nbsp;molteplici possibilità.
      </p>

      <!-- Paragrafi 2 e 3: Body Copy -->
      <div class="space-y-6 max-w-none lg:max-w-5xl">
        <p class="split-reveal text-base sm:text-xl md:text-2xl lg:text-3xl text-zinc-400 font-normal leading-relaxed md:leading-snug break-keep [hyphens:none] [overflow-wrap:normal]">
          Quando progetto, rifletto profondamente sulla relazione reciproca che c’è tra persone,
          contesto e&nbsp;tecnologia, elementi imprescindibili per sviluppare un’esperienza, immedesimandomi 
          il più possibile prima del&nbsp;live.
        </p>

        <p class="split-reveal text-base sm:text-xl md:text-2xl lg:text-3xl text-zinc-400 font-normal leading-relaxed md:leading-snug break-keep [hyphens:none] [overflow-wrap:normal]">
          La tecnologia è&nbsp;un mezzo che facilita le nostre visioni e&nbsp;può amplificarle, ma da sola non basta. Un'esperienza diventa efficace e memorabile&nbsp;quando porta valore e senso &nbsp;nella vita delle persone.
        </p>
      </div>

    </div>

    <!-- Colonna Destra: Stack e Core Competencies -->
    <div class="lg:col-span-4 border-t lg:border-t-0 lg:border-l border-zinc-900 pt-8 lg:pt-0 lg:pl-8 font-mono text-xs text-zinc-400 space-y-8 md:space-y-12 shrink-0">
      <div class="split-reveal">
        <span class="text-zinc-600 block mb-4 whitespace-nowrap">// CORE DISCIPLINE</span>
        <ul class="space-y-2.5 text-sm uppercase text-zinc-200 whitespace-nowrap">
          <li>[+] Interaction Design</li>
          <li>[+] Visual &amp; Motion Design</li>
          <li>[+] Art Direction</li>
          <li>[+] User Experience</li>
          <li>[+] Touchdesigner &amp; GLSL Shaders</li>
        </ul>
      </div>

      <div class="split-reveal">
        <span class="text-zinc-600 block mb-4">// TECHNICAL STACK</span>
        <p class="text-zinc-500 leading-relaxed">
          Touchdesigner, Arduino &amp; Hardware, Python, Glsl Shaders
        </p>
      </div>
    </div>

  </div>
</section>

<style>
  /* Maschera di ritaglio per le righe create dallo SplitText */
  :global(.split-line) {
    overflow: hidden !important;
    display: block;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';

  gsap.registerPlugin(ScrollTrigger, SplitText);

  function setupAnimations() {
    const aboutTitle = document.querySelector(".about-slide-left");
    const meTitle = document.querySelector(".me-slide-right");

    // 1. "ABOUT" entra da Sinistra
    if (aboutTitle) {
      gsap.fromTo(aboutTitle, 
        { x: -100, opacity: 0 },
        {
          x: 0,
          opacity: 1,
          duration: 0.5,
          ease: "power3.out",
          scrollTrigger: {
            trigger: ".about-container",
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    }

    // 2. "ME" entra da Destra
    if (meTitle) {
      gsap.fromTo(meTitle, 
        { x: 800, opacity: 0 },
        {
          x: 0,
          opacity: 1,
          duration: 0.75,
          ease: "power3.out",
          scrollTrigger: {
            trigger: ".about-container",
            start: "top 85%",
            toggleActions: "play none none reverse"
          }
        }
      );
    }

    // 3. Tutti i paragrafi entrano in parallelo con lo SplitText
    const splitTargets = document.querySelectorAll(".split-reveal");

    splitTargets.forEach((target) => {
      if (target.anim) {
        target.anim.progress(1).kill();
        target.split.revert();
      }

      target.split = new SplitText(target, {
        type: "lines,chars",
        linesClass: "split-line"
      });

      target.anim = gsap.fromTo(target.split.chars, 
        { y: 40, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.35,
          ease: "power2.out",
          stagger: 0.006,
          scrollTrigger: {
            trigger: target,
            start: "top 90%",
            toggleActions: "play none none reverse"
          }
        }
      );
    });

    ScrollTrigger.refresh();
  }

  if (document.readyState === "complete" || document.readyState === "interactive") {
    setupAnimations();
  } else {
    document.addEventListener("DOMContentLoaded", setupAnimations);
  }
</script>