---
import HlsPlayer from './HlsPlayer.astro';
import MediaElement from './MediaElement.astro';
import { Image } from 'astro:assets';

interface Props {
  block: any;
}

const { block } = Astro.props;
const type = block.discriminant;
const data = block.value;

const getAspectClass = (ratio: string) => {
  switch(ratio) {
    case '21-9': return 'aspect-[21/9]';
    case '16-9': return 'aspect-video';
    case '4-3': return 'aspect-[4/3]';
    case '1-1': return 'aspect-square';
    case '4-5': return 'aspect-[4/5]';
    case '3-4': return 'aspect-[3/4]';
    case '9-16': return 'aspect-[9/16]';
    default: return 'aspect-video';
  }
};

const getMobileColsClass = (isDivided: boolean, mobileCols: string) => {
  if (!isDivided) return 'grid-cols-1';
  switch(mobileCols) {
    case '2': return 'grid-cols-2';
    case '3': return 'grid-cols-3';
    case '4': return 'grid-cols-4';
    case '5': return 'grid-cols-5';
    default: return 'grid-cols-2';
  }
};

const getReelsGridCols = (cols: string, isDivided = false, mobileCols = '2') => {
  const mCols = getMobileColsClass(isDivided, mobileCols);
  
  switch(cols) {
    case '2': return `${mCols} sm:grid-cols-2 gap-3 sm:gap-4`;
    case '3': return `${mCols} sm:grid-cols-3 gap-3 sm:gap-4`;
    case '4': return `${mCols} sm:grid-cols-4 gap-2 sm:gap-3`;
    case '5': return `${mCols} sm:grid-cols-5 gap-2 sm:gap-3`;
    case '10': return `${mCols} sm:grid-cols-6 lg:grid-cols-10 gap-1.5 sm:gap-2`;
    case '15': return `${mCols} sm:grid-cols-8 lg:grid-cols-[repeat(15,minmax(0,1fr))] gap-1 sm:gap-1.5`;
    case '20': return `${mCols} sm:grid-cols-10 lg:grid-cols-[repeat(20,minmax(0,1fr))] gap-1 sm:gap-1`;
    default: return `${mCols} sm:grid-cols-5 gap-2 sm:gap-3`;
  }
};

const allMediaFiles = import.meta.glob('/src/assets/projects/**/*.{jpeg,jpg,png,webp,avif,gif,mp4,webm,mov}', { eager: true });

const resolveMediaItem = (pathOrObj: any, caption?: string) => {
  let url = pathOrObj;
  if (typeof pathOrObj === 'string' && allMediaFiles[pathOrObj]) {
    const mod: any = allMediaFiles[pathOrObj];
    url = typeof mod === 'string' ? mod : (mod.default?.src || mod.default || mod.src || pathOrObj);
  } else if (typeof pathOrObj === 'object') {
    url = pathOrObj.r2Url || pathOrObj.image || pathOrObj.url;
  }
  
  if (!url || typeof url !== 'string') return null;

  const lowerUrl = url.toLowerCase();
  
  const isYouTube = lowerUrl.includes('youtube.com') || lowerUrl.includes('youtu.be');
  let youtubeId = null;
  if (isYouTube) {
    const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([^&?]+)/);
    if (match && match[1]) youtubeId = match[1];
  }

  const isLoopVideo = !isYouTube && (lowerUrl.endsWith('.mp4') || lowerUrl.endsWith('.webm') || lowerUrl.endsWith('.mov') || lowerUrl.includes('.mp4?') || lowerUrl.includes('.webm?') || lowerUrl.includes('.mov?'));
  const isHls = !isYouTube && lowerUrl.includes('.m3u8');
  
  return { url, isLoopVideo, isHls, isYouTube, youtubeId, caption: caption || pathOrObj.caption || pathOrObj.title };
};

const getFolderMedia = (folder: string | undefined, maxLimit = 150) => {
  if (!folder || folder.trim() === '') return [];
  const target = folder.trim();
  return Object.keys(allMediaFiles).filter((path) => path.includes(`/${target}/`)).slice(0, maxLimit).map((path) => resolveMediaItem(path)).filter(Boolean);
};

const grid8x2Items = data.folderName ? getFolderMedia(data.folderName, 16) : (data.images || []).map((img: string) => resolveMediaItem(img)).filter(Boolean);
const triptychItems = data.folderName ? getFolderMedia(data.folderName, 30) : (data.items || []).map((item: any) => resolveMediaItem(item)).filter(Boolean);
const verticalReelsItems = data.folderName ? getFolderMedia(data.folderName, 150) : (data.items || []).map((item: any) => resolveMediaItem(item)).filter(Boolean);
const filmstripItems = data.folderName ? getFolderMedia(data.folderName, 50) : (data.images || []).map((img: string) => resolveMediaItem(img)).filter(Boolean);
const animatedLoopsItems = data.folderName ? getFolderMedia(data.folderName, 60) : (data.items || []).map((item: any) => resolveMediaItem(item)).filter(Boolean);
---

{/* === 01. HERO CINEMATIC === */}
{type === 'heroCinematic' && (() => {
  const media = resolveMediaItem(data.r2Url || data.image, data.caption);
  return media && (
    <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
      {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">// {data.sectionCaption}</div>}
      <div class={`w-full ${getAspectClass(data.aspectRatio)} bg-zinc-900 overflow-hidden border border-zinc-800 shadow-2xl relative block shrink-0`}>
        <MediaElement media={media} />
      </div>
      {media.caption && <p class="font-mono text-xs text-zinc-500 uppercase tracking-widest mt-3 text-center">// {media.caption}</p>}
    </div>
  );
})()}

{/* === 02. TOP PREVIEW GRID 8x2 === */}
{type === 'gridTop8x2' && grid8x2Items.length > 0 && (
  <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
    <div class="flex justify-between items-center font-mono text-xs uppercase tracking-widest text-zinc-500 mb-4 border-b border-zinc-900/50 pb-3 select-none">
      <span>// {data.sectionCaption || 'PREVIEW ARCHIVE — CLICCA PER INGRANDIRE'}</span>
      <span>FRAMES: ({grid8x2Items.length})</span>
    </div>
    
    {/* MOBILE SLIDESHOW */}
    <mobile-auto-slider class="block sm:hidden relative w-full aspect-video bg-zinc-900 overflow-hidden border border-zinc-800/80">
      {grid8x2Items.map((item: any, idx: number) => (
        <div data-lightbox-index={!item.isYouTube && !item.isHls ? idx : null} data-src={item.url} class={`slide absolute inset-0 transition-opacity duration-700 ease-in-out opacity-0 z-0 ${!item.isYouTube && !item.isHls ? 'cursor-pointer' : ''}`}>
          {item.isYouTube || item.isHls ? (
             <MediaElement media={item} />
          ) : item.isLoopVideo ? (
            <video src={item.url} autoplay loop muted playsinline class="w-full h-full object-cover block pointer-events-none" />
          ) : (
            <img src={item.url} alt={`Frame ${idx + 1}`} class="w-full h-full object-cover block" />
          )}
        </div>
      ))}
    </mobile-auto-slider>

    {/* DESKTOP GRID */}
    <div class="hidden sm:grid sm:grid-cols-4 lg:grid-cols-8 gap-2">
      {grid8x2Items.map((item: any, idx: number) => (
        <div data-lightbox-index={!item.isYouTube && !item.isHls ? idx : null} data-src={item.url} class={`group relative aspect-video bg-zinc-900 overflow-hidden border border-zinc-800/80 transition-all duration-300 shrink-0 block ${!item.isYouTube && !item.isHls ? 'cursor-pointer hover:border-white hover:z-10' : ''}`}>
          {item.isYouTube || item.isHls ? (
             <MediaElement media={item} />
          ) : item.isLoopVideo ? (
            <video src={item.url} autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500 block pointer-events-none" />
          ) : (
            <img src={item.url} alt={`Frame ${idx + 1}`} class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500 block" />
          )}
          {!item.isYouTube && !item.isHls && (
            <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
              <span class="font-mono text-[9px] uppercase tracking-widest text-white border border-white px-1.5 py-0.5 bg-black/80">ZOOM</span>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
)}

{/* === 03. SPLIT SCREEN 50/50 === */}
{type === 'split5050' && (() => {
  const left = resolveMediaItem(data.leftR2 || data.leftImage);
  const right = resolveMediaItem(data.rightR2 || data.rightImage);
  return (
    <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
      {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">// {data.sectionCaption}</div>}
      <div class={`grid ${data.mobileStack !== false ? 'grid-cols-1' : 'grid-cols-2'} md:grid-cols-2 gap-4 shrink-0`}>
        <div class={`${getAspectClass(data.aspectRatio)} bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0`}>
          <MediaElement media={left} />
        </div>
        <div class={`${getAspectClass(data.aspectRatio)} bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0`}>
          <MediaElement media={right} />
        </div>
      </div>
    </div>
  );
})()}

{/* === 04. ASIMMETRICO 70/30 === */}
{type === 'asymmetric7030' && (() => {
  const left = resolveMediaItem(data.leftR2 || data.leftImage);
  const right = resolveMediaItem(data.rightR2 || data.rightImage);
  return (
    <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
      {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">// {data.sectionCaption}</div>}
      <div class="grid grid-cols-10 gap-2 sm:gap-3 md:gap-4 w-full items-stretch shrink-0">
        <div class={`col-span-7 ${getAspectClass(data.leftRatio || '16-9')} bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0`}>
          <MediaElement media={left} />
        </div>
        <div class="col-span-3 h-full max-h-full bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0 flex items-center justify-center">
          <MediaElement media={right} />
        </div>
      </div>
    </div>
  );
})()}

{/* === 05. ASIMMETRICO 30/70 === */}
{type === 'asymmetric3070' && (() => {
  const left = resolveMediaItem(data.leftR2 || data.leftImage);
  const right = resolveMediaItem(data.rightR2 || data.rightImage);
  return (
    <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
      {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">// {data.sectionCaption}</div>}
      <div class="grid grid-cols-10 gap-2 sm:gap-3 md:gap-4 w-full items-stretch shrink-0">
        <div class="col-span-3 h-full max-h-full bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0 flex items-center justify-center">
          <MediaElement media={left} />
        </div>
        <div class={`col-span-7 ${getAspectClass(data.rightRatio || '16-9')} bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0`}>
          <MediaElement media={right} />
        </div>
      </div>
    </div>
  );
})()}

{/* === 06. TRITTICO GALLERY === */}
{type === 'triptychGrid' && triptychItems.length > 0 && (
  <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
    {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">// {data.sectionCaption}</div>}
    <div class={`grid ${data.mobileStack !== false ? 'grid-cols-1' : 'grid-cols-3'} sm:grid-cols-3 gap-4 shrink-0`}>
      {triptychItems.map((item: any) => (
        <div class={`${getAspectClass(data.aspectRatio || '4-3')} bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0`}>
          <MediaElement media={item} />
        </div>
      ))}
    </div>
  </div>
)}

{/* === 07. VERTICAL REELS GRID === */}
{type === 'verticalReelsGrid' && verticalReelsItems.length > 0 && (
  <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
    {data.sectionCaption && (
      <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">
        // {data.sectionCaption}
      </div>
    )}
    <div class={`grid ${getReelsGridCols(data.columns, data.mobileLayout?.discriminant === true, data.mobileLayout?.value || '2')}`}>
      {verticalReelsItems.map((item: any) => (
        <div class={`${getAspectClass(data.aspectRatio || '9-16')} bg-zinc-900 overflow-hidden border border-zinc-800/80 hover:border-zinc-500 transition-colors relative block shrink-0 group`}>
          <MediaElement media={item} />
        </div>
      ))}
    </div>
  </div>
)}

{/* === 08. BENTO GRID EDITORIALE === */}
{type === 'bentoGrid' && (() => {
  const main = resolveMediaItem(data.mainR2 || data.mainImage);
  const top = resolveMediaItem(data.topRightR2 || data.topRightImage);
  const bottom = resolveMediaItem(data.bottomRightR2 || data.bottomRightImage);
  return (
    <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
      {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">// {data.sectionCaption}</div>}
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 shrink-0">
        <div class="lg:col-span-2 aspect-video lg:aspect-auto bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0">
          <MediaElement media={main} />
        </div>
        <div class="flex flex-col gap-4">
          <div class="aspect-video bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0">
            <MediaElement media={top} />
          </div>
          <div class="aspect-video bg-zinc-900 overflow-hidden border border-zinc-800 relative block shrink-0">
            <MediaElement media={bottom} />
          </div>
        </div>
      </div>
    </div>
  );
})()}

{/* ── ■ ── [09] Gallery Isolated (Singolo Centrato) */}
{block.discriminant === 'galleryIsolated' && (
  <div class="relative w-full h-[80vh] md:h-[90vh] p-4 sm:p-8 bg-[#050505]">
    {block.value.type === 'image' && block.value.image ? (
      <Image 
        src={block.value.image} 
        alt={block.value.caption || "Isolated view"} 
        width={1920} 
        height={1080}
        class="w-full h-full object-contain block mx-auto" 
      />
    ) : block.value.type === 'video' && block.value.r2Url ? (
      <video 
        src={block.value.r2Url} 
        autoplay 
        loop 
        muted 
        playsinline
        preload="auto"
        class="w-full h-full object-contain block mx-auto"
      ></video>
    ) : null}
  </div>
)}

{/* === 10. FILMSTRIP MARQUEE === */}
{type === 'filmstrip' && filmstripItems.length > 0 && (
  <div class="w-full my-10 sm:my-12 shrink-0 block">
    {data.sectionCaption && <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 px-6 block select-none">// {data.sectionCaption}</div>}
    <div class="overflow-x-auto pb-4 border-y border-zinc-900 py-6 scrollbar-none shrink-0 block">
      <div class="flex gap-4 w-max px-6">
        {filmstripItems.map((item: any) => (
          <div class="h-56 sm:h-72 aspect-video bg-zinc-900 overflow-hidden border border-zinc-800 flex-shrink-0 relative block">
            {item.isYouTube || item.isHls ? (
               <MediaElement media={item} />
            ) : item.isLoopVideo ? (
              <video src={item.url} autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 block pointer-events-none" />
            ) : (
              <img src={item.url} alt="Strip" class="absolute inset-0 w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500 block" />
            )}
          </div>
        ))}
      </div>
    </div>
  </div>
)}

{/* === 11. INTERRUZIONE EDITORIALE === */}
{type === 'editorialQuote' && (
  <div class="my-16 sm:my-20 py-10 border-y border-zinc-900/80 max-w-5xl mx-auto text-center px-6 shrink-0 block">
    {data.sectionCaption && <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-500 block mb-6 select-none">// {data.sectionCaption}</span>}
    {data.author && !data.sectionCaption && <span class="font-mono text-xs uppercase tracking-widest text-zinc-500 block mb-6">[ // {data.author} ]</span>}
    <p class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-zinc-200 tracking-tight leading-tight uppercase">
      "{data.quote}"
    </p>
  </div>
)}

{/* === 12. ANIMATED LOOPS SHOWCASE === */}
{type === 'animatedLoopsGrid' && animatedLoopsItems.length > 0 && (
  <div class="w-full my-8 sm:my-10 md:my-12 shrink-0 block">
    {data.sectionCaption && (
      <div class="font-mono text-[10px] text-zinc-500 uppercase tracking-widest mb-3 sm:mb-4 block select-none">
        // {data.sectionCaption}
      </div>
    )}
    <div class={`grid ${data.mobileStack !== false ? 'grid-cols-1' : 'grid-cols-2'} ${data.columns === '3' ? 'md:grid-cols-3' : data.columns === '4' ? 'md:grid-cols-4' : 'md:grid-cols-2'} gap-4`}>
      {animatedLoopsItems.map((item: any) => (
        <div class="aspect-video bg-zinc-900 overflow-hidden border border-zinc-800/80 hover:border-zinc-400 transition-all duration-300 relative block shrink-0 group">
          <MediaElement media={item} />
          {item.caption && (
            <div class="absolute bottom-2 left-2 z-10 bg-black/80 backdrop-blur-md px-2 py-1 border border-zinc-700/50 font-mono text-[9px] uppercase tracking-widest text-zinc-300">
              {item.caption}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
)}

{/* ── ■ ■ ── [13] Double Gallery Isolated (Coppia Centrata) */}
{block.discriminant === 'doubleIsolated' && (
  <div class="relative w-full h-[80vh] md:h-[90vh] p-4 sm:p-8 bg-[#050505] flex flex-col md:flex-row gap-4 sm:gap-8 justify-center items-center">
    
    {/* MEDIA SINISTRA */}
    <div class={`w-full ${block.value.mobileStack !== false ? 'h-1/2 md:h-full md:w-1/2' : 'h-full w-1/2'} relative`}>
      {block.value.leftType === 'image' && block.value.leftImage ? (
        <Image 
          src={block.value.leftImage} 
          alt="Left view" 
          width={1920} 
          height={1080}
          class="w-full h-full object-contain block mx-auto" 
        />
      ) : block.value.leftType === 'imageR2' && block.value.leftR2 ? (
        <img 
          src={block.value.leftR2} 
          alt="Left view R2" 
          loading="lazy"
          class="w-full h-full object-contain block mx-auto" 
        />
      ) : block.value.leftType === 'video' && block.value.leftR2 ? (
        <video 
          src={block.value.leftR2} 
          autoplay loop muted playsinline preload="auto"
          class="w-full h-full object-contain block mx-auto"
        ></video>
      ) : null}
    </div>

    {/* MEDIA DESTRA */}
    <div class={`w-full ${block.value.mobileStack !== false ? 'h-1/2 md:h-full md:w-1/2' : 'h-full w-1/2'} relative`}>
      {block.value.rightType === 'image' && block.value.rightImage ? (
        <Image 
          src={block.value.rightImage} 
          alt="Right view" 
          width={1920} 
          height={1080}
          class="w-full h-full object-contain block mx-auto" 
        />
      ) : block.value.rightType === 'imageR2' && block.value.rightR2 ? (
        <img 
          src={block.value.rightR2} 
          alt="Right view R2" 
          loading="lazy"
          class="w-full h-full object-contain block mx-auto" 
        />
      ) : block.value.rightType === 'video' && block.value.rightR2 ? (
        <video 
          src={block.value.rightR2} 
          autoplay loop muted playsinline preload="auto"
          class="w-full h-full object-contain block mx-auto"
        ></video>
      ) : null}
    </div>

  </div>
)}

<script>
  class MobileAutoSlider extends HTMLElement {
    interval: number | undefined;
    slides: NodeListOf<Element> | undefined;
    currentIndex: number = 0;

    connectedCallback() {
      this.slides = this.querySelectorAll('.slide');
      if (!this.slides || this.slides.length === 0) return;
      
      this.currentIndex = 0;
      
      this.slides[0].classList.remove('opacity-0', 'z-0');
      this.slides[0].classList.add('opacity-100', 'z-10');

      if (this.slides.length > 1) {
        this.interval = window.setInterval(() => {
          if (window.innerWidth >= 640) return; 
          
          if (!this.slides) return;

          const prevIndex = this.currentIndex;
          this.currentIndex = (this.currentIndex + 1) % this.slides.length;
          
          this.slides[prevIndex].classList.remove('opacity-100', 'z-10');
          this.slides[prevIndex].classList.add('opacity-0', 'z-0');
          
          this.slides[this.currentIndex].classList.remove('opacity-0', 'z-0');
          this.slides[this.currentIndex].classList.add('opacity-100', 'z-10');
        }, 2000); 
      }
    }
    
    disconnectedCallback() {
      if (this.interval) clearInterval(this.interval);
    }
  }
  
  if (!customElements.get('mobile-auto-slider')) {
    customElements.define('mobile-auto-slider', MobileAutoSlider);
  }

  // ==========================================
  // LA TUA LOGICA DI BYPASS GLOBALE (MP4/WEBM)
  // ==========================================
  document.addEventListener('astro:page-load', () => {
    // Aspettiamo 1 secondo per vedere se i video partono naturalmente
    setTimeout(() => {
      document.querySelectorAll('video').forEach((video) => {
        // Ignoriamo i player HLS perché hanno già il loro bypass nel file HlsPlayer.astro
        if (video.hasAttribute('data-hls-player')) return;

        // Se il video è nativo ed è in stallo (0 dati scaricati) o ha dato un errore fatale
        if (video.readyState === 0 || video.error) {
          console.warn("Bypass MP4: Video in stallo rilevato. Forzo il ricaricamento nativo...");
          
          const currentSrc = video.src;
          if (currentSrc) {
            // Svuota e ricarica il tag
            video.src = '';
            video.load();
            video.src = currentSrc;
            video.muted = true; // Necessario per bypassare i blocchi autoplay
            video.load();
            
            // Forza il riavvio
            video.play().catch(() => {});
          }
        }
      });
    }, 1000); 
  });
</script>