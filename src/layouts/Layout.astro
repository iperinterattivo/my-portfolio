---
import '../styles/global.css';
import Loader from '../components/core/Loader.astro';
import { ClientRouter } from 'astro:transitions'; 
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Enrico Scigliuto | Creative Technologist" } = Astro.props;
---

<!doctype html>
<html lang="it" class="dark font-sans overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/Icon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
    
    <!-- Router SPA nativo per Astro 5+ -->
    <ClientRouter />
  </head>
  
  <body class="min-h-screen bg-[#0a0a0a] text-[#e5e5e5] selection:bg-white selection:text-black relative overflow-x-hidden w-full">
    
    <Loader />

    <div class="fixed inset-0 pointer-events-none z-50 opacity-[0.035] bg-noise"></div>

    <!-- 
      NAVBAR ORIGINALE (FIXED IN ALTO ALLO SCROLL)
    -->
    <header 
      id="main-header"
      class="fixed top-0 left-0 w-full z-40 py-6 px-5 sm:px-8 md:px-10 lg:px-12 flex justify-between items-center mix-blend-difference pointer-events-none transition-transform duration-500 ease-out -translate-y-full"
    >
      <a href="/" class="reveal-ui text-sm font-bold tracking-tighter font-display uppercase pointer-events-auto">
      ENRICO SCIGLIUTO
      </a>
      
      <!-- MENU ESTESO SULLA METÀ DESTRA DELLO SCHERMO -->
      <nav class="reveal-ui flex items-center justify-between w-full md:w-1/2 text-xs uppercase tracking-widest font-medium text-zinc-400 pointer-events-auto ml-auto pl-4 md:pl-12">
        <a href="/#work" class="hover:text-white transition-colors">Works</a>
        <a href="/#about" class="hover:text-white transition-colors">About Me</a>
        <a href="/#contacts" class="hover:text-white transition-colors">Contacts</a>
      </nav>
    </header>

    <main class="relative z-10 w-full max-w-[1920px] mx-auto px-5 sm:px-8 md:px-10 lg:px-12">
      <slot />
    </main>

    <!-- TRANSIZIONE MOVIMENTO ASSE Y E FIX SCROLL -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initHeaderShift() {
        const mainHeader = document.getElementById('main-header');
        const heroNavbar = document.getElementById('hero-navbar');

        if (!mainHeader || !heroNavbar) return;

        ScrollTrigger.create({
          start: 'top top+=40',
          onUpdate: (self) => {
            if (self.scroll() > 40) {
              mainHeader.classList.remove('-translate-y-full', 'pointer-events-none');
              mainHeader.classList.add('translate-y-0');

              heroNavbar.classList.add('-translate-y-12', 'opacity-0', 'pointer-events-none');
              heroNavbar.classList.remove('translate-y-0', 'opacity-100');
            } else {
              mainHeader.classList.remove('translate-y-0');
              mainHeader.classList.add('-translate-y-full', 'pointer-events-none');

              heroNavbar.classList.remove('-translate-y-12', 'opacity-0', 'pointer-events-none');
              heroNavbar.classList.add('translate-y-0', 'opacity-100');
            }
          }
        });
      }

      let isAstroNavigation = false;

      document.addEventListener('astro:before-preparation', () => {
        isAstroNavigation = true;
      });

      document.addEventListener('astro:page-load', () => {
        initHeaderShift();

        const hash = window.location.hash;
        
        if (isAstroNavigation && hash) {
          const target = document.querySelector(hash);
          if (target) {
            document.documentElement.classList.remove('scroll-smooth');
            target.scrollIntoView({ behavior: 'auto', block: 'start' });
          }
        }
        
        setTimeout(() => {
          document.documentElement.classList.add('scroll-smooth');
        }, 150);

        isAstroNavigation = false;
      });
    </script>
  </body>
</html>